<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
          Every provider's encrypted credential lives in the file domain, so the whole domain is
          excluded rather than named files: adding a provider must not be able to leak a key
          off-device by being forgotten here.
        -->
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
